<?xml version="1.0" encoding="utf-8"?>
<!-- 顶部小胶囊按钮（上级 / 排序 / 搜索） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_ghost_press" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rail_focus" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pill_fill" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/stroke" />
        </shape>
    </item>
</selector>
