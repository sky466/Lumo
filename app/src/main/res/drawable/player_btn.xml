<?xml version="1.0" encoding="utf-8"?>
<!-- 播放器按钮：玻璃质感，颜色跟主题走（遥控器焦点/手机按下都高亮） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/player_btn_press" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/player_btn_focus" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/player_btn_focus_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/player_btn_fill" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/player_btn_stroke" />
        </shape>
    </item>
</selector>
