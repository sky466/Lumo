<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面（电视 / 平板，宽度 ≥ 720dp）
  · 顶部一行：LUMO + 紧跟着的主题按钮（月牙/太阳）· 右边「＋」「⚙ 设置」
  · 下面：我的服务器列表；插了 U 盘时右侧再出现 U 盘一列，没插就整列隐藏
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_main"
    android:paddingLeft="40dp"
    android:paddingRight="40dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brand"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:letterSpacing="0.16" />

        <!-- 主题切换（v1.47）：紧跟在 LUMO 后面当作品牌的一部分；深色＝月牙，浅色＝太阳 -->
        <ImageView
            android:id="@+id/btn_theme"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="10dp"
            android:padding="8dp"
            android:background="@drawable/icon_btn"
            android:focusable="true"
            android:clickable="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="360dp"
            android:text="@string/connecting"
            android:textSize="14sp"
            android:textColor="@color/accent_light"
            android:gravity="right"
            android:singleLine="true"
            android:ellipsize="start"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="+"
            android:textSize="30sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="10dp"
            android:background="@drawable/icon_btn"
            android:focusable="true"
            android:clickable="true" />
        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="6dp"
            android:padding="11dp"
            android:background="@drawable/icon_btn"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/divider" />

    <!-- 继续观看（v1.45）：最近播过的几条，点一下直接续播；长按可移除 -->
    <LinearLayout
        android:id="@+id/continue_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_section"
        android:padding="14dp"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="3dp"
                android:layout_height="15dp"
                android:background="@color/accent2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/section_continue"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/continue_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textSize="11sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            android:focusable="false">

            <LinearLayout
                android:id="@+id/continue_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 内容 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <!-- 我的服务器 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical"
            android:background="@drawable/card_section"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="4dp"
                    android:layout_height="18dp"
                    android:background="@color/accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="@string/section_servers"
                    android:textSize="18sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/server_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginLeft="10dp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/server_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:scrollbars="none"
                android:focusable="false"
                android:descendantFocusability="afterDescendants">

                <LinearLayout
                    android:id="@+id/server_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/server_empty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="@string/no_server"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/text_tertiary"
                android:gravity="center"
                android:visibility="gone" />

        </LinearLayout>

        <!-- U 盘（没插就整列隐藏，服务器列自动占满） -->
        <LinearLayout
            android:id="@+id/usb_section"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical"
            android:background="@drawable/card_section"
            android:padding="18dp"
            android:layout_marginLeft="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="4dp"
                    android:layout_height="18dp"
                    android:background="@color/warn" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="@string/section_usb"
                    android:textSize="18sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/usb_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginLeft="10dp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/usb_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:scrollbars="none"
                android:focusable="false"
                android:descendantFocusability="afterDescendants">

                <LinearLayout
                    android:id="@+id/usb_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/usb_empty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="@string/no_usb"
                android:textSize="15sp"
                android:textColor="@color/text_tertiary"
                android:gravity="center"
                android:visibility="gone" />


        </LinearLayout>

    </LinearLayout>

</LinearLayout>
