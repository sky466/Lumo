<?xml version="1.0" encoding="utf-8"?>
<!-- 「＋」弹出的添加服务器对话框：SMB / WebDAV 共用一套表单 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:padding="26dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dlg_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_server_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_server_hint"
            android:textSize="13sp"
            android:textColor="@color/text_tertiary"
            android:paddingTop="6dp"
            android:paddingBottom="18dp" />

        <!-- 类型切换：SMB / WebDAV -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_smb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/smb"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:background="@drawable/tab_off"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/tab_webdav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="12dp"
                android:text="@string/webdav"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:background="@drawable/tab_off"
                android:focusable="true"
                android:clickable="true" />

        </LinearLayout>

        <TextView
            android:id="@+id/label_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="名称（可空，用来区分多台服务器）"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:paddingTop="14dp"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/edit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如：客厅 NAS / Mac 共享"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:singleLine="true"
            android:background="@drawable/input_bg"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/label_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/host"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:paddingTop="18dp"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/edit_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/host_hint_smb"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:background="@drawable/input_bg"
            android:padding="13dp"
            android:inputType="textUri"
            android:maxLines="1" />

        <TextView
            android:id="@+id/btn_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="扫描局域网（自动找 445 端口）"
            android:textSize="13sp"
            android:textColor="@color/accent"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:background="@drawable/btn_ghost"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/label_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:paddingTop="14dp"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/edit_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/share_hint"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:background="@drawable/input_bg"
            android:padding="13dp"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/username"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:paddingTop="14dp"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/edit_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/username_hint"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:background="@drawable/input_bg"
            android:padding="13dp"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/password"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:paddingTop="14dp"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/edit_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:background="@drawable/input_bg"
            android:padding="13dp"
            android:inputType="textPassword"
            android:maxLines="1" />

        <TextView
            android:id="@+id/dlg_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/accent_light"
            android:paddingTop="14dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="22dp">

            <TextView
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/btn_ghost"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginLeft="12dp"
                android:text="@string/save_and_connect"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/btn_primary"
                android:focusable="true"
                android:clickable="true" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
