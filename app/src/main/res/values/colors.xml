    <color name="bg_a">#EEF2F9</color>
    <color name="bg_b">#FFFFFF</color>
    <color name="card">#FFFFFF</color>
    <color name="card_press">#EFF4FC</color>
    <color name="card_focus">#E7EFFE</color>
    <color name="stroke">#DCE4EF</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_stroke">#E3EAF3</color>
    <color name="list_stroke">#E6ECF5</color>
    <color name="divider">#E6ECF5</color>

    <!-- 品牌色 -->
    <color name="accent">#2563EB</color>
