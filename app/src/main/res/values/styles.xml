<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 播放器主控按钮：等宽大按钮，电视焦点态和手机触摸都好看 -->
    <style name="PlayerBtn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/player_btn</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
    </style>

    <!-- 次要功能小按钮 -->
    <style name="PlayerBtnSmall" parent="PlayerBtn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:paddingLeft">13dp</item>
        <item name="android:paddingRight">13dp</item>
        <item name="android:layout_marginLeft">8dp</item>
    </style>
</resources>
