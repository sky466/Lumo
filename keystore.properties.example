# 复制成 keystore.properties 后按自己的情况改，然后 ./gradlew assembleRelease
# 没有这个文件时也能编译，只是 release 包不签名。
storeFile=letvcast.keystore
storePassword=你的密码
keyAlias=letvcast
keyPassword=你的密码

# 第一次用的话先生成一个自己的签名（命令见 docs/BUILD.md）：
#   keytool -genkeypair -v -keystore letvcast.keystore -alias letvcast \
#           -keyalg RSA -keysize 2048 -validity 10000
